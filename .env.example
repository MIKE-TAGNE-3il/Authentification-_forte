# ═══════════════════════════════════════════════════════════════════════════════
#  AuthForte — Variables d'environnement
#  Copiez ce fichier en ".env" et remplissez les valeurs AVANT de lancer Docker.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Clé secrète Flask (CHANGEZ-LA en production) ─────────────────────────────
SECRET_KEY=changeme_generez_une_cle_aleatoire_de_64_chars

# ── Base de données MySQL ─────────────────────────────────────────────────────
DB_HOST=db
DB_USER=authforte
DB_PASSWORD=authforte_password
DB_NAME=authentification
DB_PORT=3306

# Mot de passe root MySQL (pour le conteneur db)
MYSQL_ROOT_PASSWORD=root_secure_password
MYSQL_DATABASE=authentification
MYSQL_USER=authforte
MYSQL_PASSWORD=authforte_password

# ── Flask ─────────────────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=0

# ── SMTP / E-mail OTP ─────────────────────────────────────────────────────────
# En développement : utilisez MailHog (pas de vraie configuration SMTP nécessaire)
#   MAIL_SMTP_HOST=mailhog
#   MAIL_SMTP_PORT=1025
#   MAIL_SMTP_USER=
#   MAIL_SMTP_PASSWORD=
#   MAIL_FROM=no-reply@authforte.local
#
# En production : remplissez avec vos identifiants Gmail / SMTP réel
MAIL_SMTP_HOST=mailhog
MAIL_SMTP_PORT=1025
MAIL_SMTP_USER=
MAIL_SMTP_PASSWORD=
MAIL_FROM=no-reply@authforte.local
# Mettre à 1 pour afficher le code dans les logs (développement uniquement)
MAIL_DEBUG=0

# ── NFC ───────────────────────────────────────────────────────────────────────
# Durée de validité d'une carte NFC enregistrée (en jours)
NFC_CARD_VALIDITY_DAYS=30

# ── WebAuthn (empreinte digitale) ─────────────────────────────────────────────
# En local : localhost / http://localhost:5000
# En production : votre vrai domaine
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=AuthentificationForte
WEBAUTHN_ORIGIN=http://localhost:5000
