# ═══════════════════════════════════════════════════════════════════════════════
#  AuthForte — Règles udev Linux
#  Emplacement : /etc/udev/rules.d/99-authforte.rules
#
#  Ces règles donnent les permissions d'accès aux périphériques USB utilisés
#  par la plateforme (NFC, smart card, biométrie) au groupe "plugdev".
#
#  Installation automatique : scripts/install.sh
#  Installation manuelle    :
#    sudo cp docker/udev/99-authforte.rules /etc/udev/rules.d/
#    sudo udevadm control --reload-rules
#    sudo udevadm trigger
# ═══════════════════════════════════════════════════════════════════════════════

# ── Lecteurs NFC/RFID génériques (ACR122U, PN532, etc.) ──────────────────────
SUBSYSTEM=="usb", ATTR{idVendor}=="072f", MODE="0664", GROUP="plugdev", TAG+="uaccess"
# ACS ACR122U
SUBSYSTEM=="usb", ATTR{idVendor}=="072f", ATTR{idProduct}=="2200", MODE="0664", GROUP="plugdev", TAG+="uaccess"
# SCM SCR3310 / SCR335
SUBSYSTEM=="usb", ATTR{idVendor}=="04e6", MODE="0664", GROUP="plugdev", TAG+="uaccess"

# ── Clés FIDO2 / Yubikey ─────────────────────────────────────────────────────
# Yubico YubiKey (toutes variantes)
SUBSYSTEM=="usb", ATTR{idVendor}=="1050", MODE="0664", GROUP="plugdev", TAG+="uaccess"
# Nitrokey / SoloKey
SUBSYSTEM=="usb", ATTR{idVendor}=="20a0", MODE="0664", GROUP="plugdev", TAG+="uaccess"

# ── Lecteurs PC/SC génériques ─────────────────────────────────────────────────
SUBSYSTEM=="usb", ENV{ID_SMARTCARD_READER}=="?*", MODE="0664", GROUP="plugdev", TAG+="uaccess"

# ── Cryptonox (carte à puce) ──────────────────────────────────────────────────
# Le Cryptonox utilise le protocole CCID — couvert par les règles PC/SC ci-dessus.
# Si votre lecteur n'est pas reconnu, ajoutez sa ligne ici :
# SUBSYSTEM=="usb", ATTR{idVendor}=="XXXX", ATTR{idProduct}=="XXXX", MODE="0664", GROUP="plugdev"
